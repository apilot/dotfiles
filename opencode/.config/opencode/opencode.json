    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek API (pay-per-token)",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek-V4 chat",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 0.28,
            "output": 0.42
          },
          "options": {
            "stream": true,
            "temperature": 0.1
          }
        },
        "deepseek-reasoner": {
          "name": "DeepSeek-V4 reasoner",
          "attachment": false,
          "reasoning": true,
          "temperature": false,
          "tool_call": false,
          "cost": {
            "input": 0.28,
            "output": 0.42
          },
          "options": {
            "stream": true
          }
        }
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local Qwen)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen2.5-coder-7b": {
          "name": "Qwen2.5-Coder-7B-Instruct Q4_K_M (local)",
