hyprlands/.config/hypr/MEMORY.md
hyprlands/.config/hypr/README_WINDOWRULES_CONVERSION.md
hyprlands/.config/hypr/hyprland.conf.backup
hyprlands/.config/hypr/hyprland.conf.backup.*
hyprlands/.config/hypr/hyprland.conf.bak
hyprlands/.config/hypr/hyprland.conf.converted
hyprlands/.config/hypr/hyprland.conf.fixed
hyprlands/.config/hypr/hyprland.conf.layerrules_fixed
