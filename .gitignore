# Aider runtime artifacts (chat/input history, tags cache) — но НЕ aider/.aider.conf.yml
.aider.chat.history*
.aider.input.history
.aider.llm.history
.aider.tags.cache
!aider/.aider.conf.yml
zsh/.zsh/secrets.zsh
# oh-my-zsh framework installed into stow package dir (managed externally)
zsh/.oh-my-zsh/
# Vendored third-party Hyprland theme (separate upstream clone, kept local only)
hyprland-common/.config/hypr/themes/winter/

.worktrees/

# Scratch / backups / agent artifacts (kept local, not tracked)
archives/
hypr-profile
hyprland-waybar/
PROFILES.md
zsh/new_feature.md
hyprlands/.config/hypr/.claude/
